{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureLanguage": {
    "Endpoint": "https://<your-language-resource>.cognitiveservices.azure.com/",
    "Key": "<your-language-key>"
  },
  "AzureOpenAI": {
    "Endpoint": "https://<your-openai-resource>.openai.azure.com/",
    "Key": "<your-openai-key>",
    "Deployment": "<your-deployment-name>",
    "ApiVersion": "2024-10-21"
  },
  "Processing": {
    "EnableDynamicAiExtraction": true,
    "EnableDynamicAiExtractionInLargeTranscriptSafeMode": false,
    "EnableLargeTranscriptSafeMode": true,
    "LargeTranscriptThresholdCharacters": 20000,
    "MaxConcurrentChunks": 3
  },
  "TranscriptChunking": {
    "ChunkMaxCharacters": 4000,
    "ChunkOverlapLines": 6
  },
  "ExternalApis": {
    "RequestTimeoutSeconds": 60,
    "AzureOpenAITimeoutSeconds": 60,
    "AzureLanguageTimeoutSeconds": 60
  }
}
