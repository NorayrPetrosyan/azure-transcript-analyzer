{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureLanguage": {
    "Endpoint": "",
    "Key": ""
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "Key": "",
    "Deployment": "",
    "ApiVersion": "2024-10-21"
  },
  "Processing": {
    "EnableDynamicAiExtraction": true,
    "EnableDynamicAiExtractionInLargeTranscriptSafeMode": false,
    "EnableLargeTranscriptSafeMode": true,
    "LargeTranscriptThresholdCharacters": 20000,
    "MaxConcurrentChunks": 3
  },
  "TranscriptChunking": {
    "ChunkMaxCharacters": 4000,
    "ChunkOverlapLines": 6
  },
  "ExternalApis": {
    "RequestTimeoutSeconds": 60,
    "AzureOpenAITimeoutSeconds": 60,
    "AzureLanguageTimeoutSeconds": 60
  },
  "AllowedHosts": "*"
}
